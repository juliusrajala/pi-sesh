{
  "name": "pi-sesh",
  "version": "0.1.11",
  "description": "Rootless containerized command sessions",
  "module": "src/main.ts",
  "exports": {
    "./control": "./src/control/index.ts"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build --compile --target=bun-linux-x64 --outfile dist/pi-sesh src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:drive": "bun scripts/project-test-drive.ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.ts\" \"*.json\""
  },
  "dependencies": {
    "@crustjs/core": "0.0.19",
    "@crustjs/plugins": "0.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.5.3",
    "typescript": "6.0.3"
  }
}
